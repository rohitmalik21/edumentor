# ============================================
# EduMentor AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in your settings

# LLM Provider: "local" (free, no API key), "gemini", or "openai"
LLM_PROVIDER=local

# Local Hugging Face Model (free, runs on your machine)
# Options: google/flan-t5-base (~900MB, 4GB RAM)
#          google/flan-t5-large (~3GB, 8GB RAM) - recommended
LOCAL_MODEL=google/flan-t5-large

# Google Gemini API Key (optional, for cloud mode)
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional, for cloud mode)
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration (only used when provider is gemini/openai)
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-3.5-turbo

# Embedding Model (for RAG/Grounded QA)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=7860
DEBUG=false
